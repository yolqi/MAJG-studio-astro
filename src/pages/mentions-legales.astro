---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('mentionsLegales', 'mentions-legales');
const { seo, intro, editeur, hebergeur, propriete, donneesPerso } = page.data;
---
<Layout title={seo.title} description={seo.description} activePage="mentions-legales" noindex>
  <!-- INTRO -->
  <header class="hero" style="padding:calc(150px + var(--strip-h)) 0 70px">
    <div class="wrap hero-solo">
      <span class="eyebrow">{intro.eyebrow}</span>
      <h1>{intro.title}</h1>
    </div>
  </header>

  <section style="padding-top:48px">
    <div class="wrap">
      <div class="prose" style="max-width:760px">

        <h2 class="sec-h" style="font-size:1.4rem;margin-bottom:14px">{editeur.heading}</h2>
        <p>{editeur.paragraph1}</p>
        <p>{editeur.addressLines.map((line, i) => <>{line}{i < editeur.addressLines.length - 1 && <br />}</>)}</p>
        <p>{editeur.paragraph3}</p>

        <h2 class="sec-h" style="font-size:1.4rem;margin:34px 0 14px">{hebergeur.heading}</h2>
        <p>{hebergeur.addressLines.map((line, i) => <>{line}{i < hebergeur.addressLines.length - 1 && <br />}</>)}</p>

        <h2 class="sec-h" style="font-size:1.4rem;margin:34px 0 14px">{propriete.heading}</h2>
        <p>{propriete.paragraph}</p>

        <h2 class="sec-h" style="font-size:1.4rem;margin:34px 0 14px">{donneesPerso.heading}</h2>
        <p>{donneesPerso.text} <a href={donneesPerso.linkHref} class="inline-link">{donneesPerso.linkLabel}</a>.</p>

      </div>
    </div>
  </section>
</Layout>
