---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('tarifs', 'tarifs');
const { seo, intro, web, social, faq, finalCta } = page.data;
---
<Layout title={seo.title} description={seo.description} activePage="tarifs">
  <!-- INTRO -->
  <header class="hero">
    <div class="wrap hero-solo">
      <span class="eyebrow">{intro.eyebrow}</span>
      <h1>{intro.title} <em>{intro.titleEmphasis}</em></h1>
      <p class="lead">{intro.lead}</p>
    </div>
  </header>

  <!-- SITES WEB -->
  <section class="price-block" id="sites">
    <div class="wrap">
      <h3>Sites web</h3>
      <div class="price-grid">
        {web.plans.map((plan) => (
          <div class="price-wrap rv"><div class={plan.featured ? 'price feat-price' : 'price'}>
            {plan.badge && <span class="badge-pop">{plan.badge}</span>}
            <div class="pname">{plan.name}</div>
            <div class="ptag">{plan.tag}</div>
            <div class="pprice">{plan.price}<small>{plan.priceSuffix}</small></div>
            <div class="pfrom">{plan.billing}</div>
            <ul>
              {plan.features.map((feature) => (
                <li><span class="ck">✓</span> {feature}</li>
              ))}
            </ul>
            <a href="/contact" class={plan.featured ? 'btn btn-primary btn-full' : 'btn btn-dark btn-full'}>{plan.ctaLabel}</a>
          </div></div>
        ))}
      </div>
      <p class="price-note rv">{web.note}</p>
    </div>
  </section>

  <!-- RÉSEAUX SOCIAUX -->
  <section class="price-block" id="social" style="background:var(--bg2)">
    <div class="wrap">
      <h3>Réseaux sociaux</h3>
      <div class="price-grid">
        {social.plans.map((plan) => (
          <div class="price-wrap rv"><div class={plan.featured ? 'price feat-price' : 'price'}>
            {plan.badge && <span class="badge-pop">{plan.badge}</span>}
            <div class="pname">{plan.name}</div>
            <div class="ptag">{plan.tag}</div>
            <div class="pprice">{plan.price}<small>{plan.priceSuffix}</small></div>
            <div class="pfrom">{plan.billing}</div>
            <ul>
              {plan.features.map((feature) => (
                <li><span class="ck">✓</span> {feature}</li>
              ))}
            </ul>
            <a href="/contact" class={plan.featured ? 'btn btn-primary btn-full' : 'btn btn-dark btn-full'}>{plan.ctaLabel}</a>
          </div></div>
        ))}
      </div>

      <div class="alacarte rv">
        <h3 class="alacarte-h">{social.alacarteHeading}</h3>
        <ul class="alacarte-list">
          {social.alacarteItems.map((item) => (
            <li><span>{item.label}</span><strong>{item.price}</strong></li>
          ))}
        </ul>
      </div>
      <p class="price-note rv">{social.note}</p>
    </div>
  </section>

  <!-- FAQ -->
  <section>
    <div class="wrap">
      <div class="rv">
        <div class="sec-eye">{faq.eyebrow}</div>
        <h2 class="sec-h" style="margin:0 auto 18px;text-align:center">{faq.title}</h2>
      </div>
      <div class="faq-list">
        {faq.items.map((item) => (
          <div class="faq-item"><button class="faq-q">{item.question} <span class="pm">+</span></button><div class="faq-a"><p>{item.answer}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="contact">
    <div class="wrap cta-band rv">
      <div class="sec-eye">{finalCta.eyebrow}</div>
      <h2 class="sec-h">{finalCta.title}</h2>
      <a href="/contact" class="btn btn-primary">{finalCta.ctaLabel}</a>
    </div>
  </section>
</Layout>
