---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('sitesWeb', 'sites-web');
const { seo, hero, audience, why, process: howItWorks, deepDive, pricingTeaser } = page.data;
---
<Layout title={seo.title} description={seo.description} activePage="sites-web">
  <!-- HERO -->
  <header class="hero">
    <div class="wrap hero-solo">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1>{hero.title} <em>{hero.titleEmphasis}</em></h1>
      <p class="lead">{hero.lead}</p>
      <div class="hero-actions">
        <a href={hero.ctaPrimaryHref} class="btn btn-primary">{hero.ctaPrimaryLabel}</a>
        <a href={hero.ctaGhostHref} class="btn btn-ghost">{hero.ctaGhostLabel}</a>
      </div>
    </div>
  </header>

  <!-- POUR QUI -->
  <section>
    <div class="wrap">
      <div class="rv">
        <div class="sec-eye">{audience.eyebrow}</div>
        <h2 class="sec-h">{audience.title} <em>{audience.titleEmphasis}</em>{audience.titleSuffix}</h2>
        <p class="sec-sub">{audience.subtitle}</p>
      </div>
      <div class="svc-grid">
        {audience.items.map((item) => (
          <div class="svc-card rv"><div class="svc-num">{item.number}</div><h3>{item.title}</h3><p>{item.description}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- POURQUOI MAJG -->
  <section class="features">
    <div class="wrap">
      <div class="rv">
        <div class="sec-eye">{why.eyebrow}</div>
        <h2 class="sec-h">{why.title}</h2>
        <p class="sec-sub">{why.subtitle}</p>
      </div>
      <div class="feat-grid">
        {why.items.map((item) => (
          <div class="feat rv"><div class="ic">{item.icon}</div><h4>{item.title}</h4><p>{item.description}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="proc">
    <div class="wrap">
      <div class="rv">
        <div class="sec-eye">{howItWorks.eyebrow}</div>
        <h2 class="sec-h">{howItWorks.title}</h2>
        <p class="sec-sub">{howItWorks.subtitle}</p>
      </div>
      <div class="proc-grid">
        {howItWorks.steps.map((step) => (
          <div class="proc-step rv"><div class="n">{step.number}</div><h4>{step.title}</h4><p>{step.description}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- EN PROFONDEUR -->
  <section>
    <div class="wrap">
      <div class="rv prose">
        <div class="sec-eye">{deepDive.eyebrow}</div>
        <h2 class="sec-h">{deepDive.title}</h2>
        {deepDive.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- TEASER TARIFS -->
  <section style="background:var(--bg2)">
    <div class="wrap cta-band rv">
      <div class="sec-eye">{pricingTeaser.eyebrow}</div>
      <h2 class="sec-h">{pricingTeaser.title}</h2>
      <p class="sec-sub">{pricingTeaser.subtitle}</p>
      <a href={pricingTeaser.ctaHref} class="btn btn-primary">{pricingTeaser.ctaLabel}</a>
    </div>
  </section>
</Layout>
