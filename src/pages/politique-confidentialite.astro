---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('politiqueConfidentialite', 'politique-confidentialite');
const { seo, intro, sections } = page.data;
---
<Layout title={seo.title} description={seo.description} activePage="politique-confidentialite" noindex>
  <!-- INTRO -->
  <header class="hero" style="padding:calc(150px + var(--strip-h)) 0 70px">
    <div class="wrap hero-solo">
      <span class="eyebrow">{intro.eyebrow}</span>
      <h1>{intro.title}</h1>
    </div>
  </header>

  <section style="padding-top:48px">
    <div class="wrap">
      <div class="prose" style="max-width:760px">
        {sections.map((section, i) => (
          <>
            <h2 class="sec-h" style={i === 0 ? "font-size:1.4rem;margin-bottom:14px" : "font-size:1.4rem;margin:34px 0 14px"}>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </>
        ))}
      </div>
    </div>
  </section>
</Layout>
