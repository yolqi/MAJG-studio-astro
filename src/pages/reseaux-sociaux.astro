---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('reseauxSociaux', 'reseaux-sociaux');
const { seo, hero, whatWeDo, feedPreview, pitch, pricingTeaser } = page.data;
---
<Layout title={seo.title} description={seo.description} activePage="reseaux-sociaux">
  <!-- HERO -->
  <header class="hero">
    <div class="wrap hero-solo">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1>{hero.title} <em>{hero.titleEmphasis}</em></h1>
      <p class="lead">{hero.lead}</p>
      <div class="hero-actions">
        <a href={hero.ctaPrimaryHref} class="btn btn-primary">{hero.ctaPrimaryLabel}</a>
        <a href={hero.ctaGhostHref} class="btn btn-ghost">{hero.ctaGhostLabel}</a>
      </div>
    </div>
  </header>

  <!-- CE QU'ON FAIT -->
  <section>
    <div class="wrap">
      <div class="rv">
        <div class="sec-eye">{whatWeDo.eyebrow}</div>
        <h2 class="sec-h">{whatWeDo.title}</h2>
        <p class="sec-sub">{whatWeDo.subtitle}</p>
      </div>
      <div class="svc-grid">
        {whatWeDo.items.map((item) => (
          <div class="svc-card rv"><div class="svc-num">{item.number}</div><h3>{item.title}</h3><p>{item.description}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- MOCKUP TÉLÉPHONE / GRILLE INSTAGRAM -->
  <section style="background:var(--bg2)">
    <div class="wrap">
      <div class="rv" style="margin-bottom:54px">
        <div class="sec-eye">{feedPreview.eyebrow}</div>
        <h2 class="sec-h">{feedPreview.title}</h2>
      </div>
      <div class="ig-section rv">
        <div class="phone-frame">
          <div class="ph-bar"><i></i></div>
          <div class="ig-profile">
            <div class="ig-avatar"></div>
            <div class="ig-stats"><strong>12</strong><span>publications</span></div>
            <div class="ig-stats"><strong>340</strong><span>abonnés</span></div>
          </div>
          <div class="ig-grid">
            <div></div><div></div><div></div>
            <div></div><div></div><div></div>
            <div></div><div></div><div></div>
          </div>
        </div>
        <div class="ig-caption">
          <span class="style-badge">{feedPreview.badge}</span>
          <h3>{feedPreview.feedTitle}</h3>
          <ul>
            {feedPreview.bullets.map((bullet) => (
              <li><span class="ck">→</span> {bullet}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- DIFFÉRENCIATEUR -->
  <section class="pitch">
    <div class="wrap">
      <h2 class="rv">{pitch.text}</h2>
    </div>
  </section>

  <!-- TEASER TARIFS -->
  <section>
    <div class="wrap cta-band rv">
      <div class="sec-eye">{pricingTeaser.eyebrow}</div>
      <h2 class="sec-h">{pricingTeaser.title}</h2>
      <p class="sec-sub">{pricingTeaser.subtitle}</p>
      <a href={pricingTeaser.ctaHref} class="btn btn-primary">{pricingTeaser.ctaLabel}</a>
    </div>
  </section>
</Layout>
