---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('contact', 'contact');
const { seo, intro, infoItems } = page.data;
---
<Layout title={seo.title} description={seo.description} activePage="contact">
  <!-- CONTACT -->
  <section class="contact" style="padding-top:calc(150px + var(--strip-h))">
    <div class="wrap">
      <div class="rv">
        <div class="sec-eye">{intro.eyebrow}</div>
        <h2 class="sec-h">{intro.title}</h2>
        <p class="sec-sub" style="color:var(--sand);opacity:.75">{intro.subtitle}</p>
      </div>
      <div class="contact-grid">
        <div class="contact-info rv">
          {infoItems.map((item) => (
            <div class="ci"><div class="l">{item.label}</div><div class="v">{item.value}</div></div>
          ))}
        </div>
        <form class="form-card rv" id="contactForm" action="https://formsubmit.co/jules.grisolle@icloud.com" method="POST">
          <input type="hidden" name="_subject" value="Nouvelle demande de devis — MAJG Studio">
          <input type="hidden" name="_template" value="table">
          <input type="hidden" name="_captcha" value="true">
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
          <div class="form-row">
            <div class="field"><label>Prénom</label><input type="text" name="prenom" placeholder="Votre prénom" required></div>
            <div class="field"><label>Nom du commerce</label><input type="text" name="commerce" placeholder="Votre commerce" required></div>
          </div>
          <div class="form-row">
            <div class="field"><label>Email</label><input type="email" name="email" placeholder="vous@exemple.fr" required></div>
            <div class="field"><label>Téléphone</label><input type="tel" name="telephone" id="telephone" placeholder="06 00 00 00 00" inputmode="numeric" maxlength="14" pattern="[0-9]{2} [0-9]{2} [0-9]{2} [0-9]{2} [0-9]{2}" title="10 chiffres, ex. 06 12 34 56 78"></div>
          </div>
          <div class="field"><label>Votre activité</label><input type="text" name="activite" placeholder="Ex. coiffeur, restaurant, institut de beauté…"></div>
          <div class="field"><label>Parlez-nous de vous et de votre demande</label><textarea name="projet" placeholder="Décrivez votre activité et ce que vous recherchez (nouveau site, refonte, réseaux sociaux…)"></textarea></div>
          <button class="btn btn-primary btn-full" type="submit">Demander ma démo gratuite →</button>
          <p class="form-note" id="formStatus">Vos informations servent uniquement à vous recontacter. Jamais transmises à des tiers.</p>
        </form>
      </div>
    </div>
  </section>
</Layout>
