---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';

const page = await getEntry('realisations', 'realisations');
const { seo, intro, gite, institut, artisan, socialFeed, finalCta } = page.data;

const giteRoomImages = await Promise.all(gite.rooms.map((room) => getImage({ src: room.photo })));
const institutSoinImages = await Promise.all(institut.soins.map((soin) => getImage({ src: soin.photo })));
const artisanImage = await getImage({ src: artisan.photo });
const socialCellImages = await Promise.all(socialFeed.cells.map((cell) => getImage({ src: cell.photo })));

const activeRoom = gite.rooms[0];
const activeRoomImage = giteRoomImages[0];
const activeSoin = institut.soins[0];
const activeSoinImage = institutSoinImages[0];

const artisanEstimateMin = artisan.checkboxes.filter((c) => c.checked).reduce((sum, c) => sum + c.min, 0);
const artisanEstimateMax = artisan.checkboxes.filter((c) => c.checked).reduce((sum, c) => sum + c.max, 0);
---
<Layout title={seo.title} description={seo.description} activePage="realisations">
  <!-- INTRO -->
  <header class="hero">
    <div class="wrap hero-solo">
      <span class="eyebrow">{intro.eyebrow}</span>
      <h1>{intro.titleLine1} <em>{intro.titleEmphasis}</em></h1>
      <p class="lead">{intro.lead}</p>
    </div>
  </header>

  <section>
    <div class="wrap">

      <!-- GÎTE -->
      <div class="demo-card rv" style="margin-bottom:24px">
        <div class="demo-visual dv-naturel" style={`--photo:url('${activeRoomImage.src}')`}>
          <span class="badge">Concept</span>
          <span class="try-hint">À tester →</span>
          <div class="m-eye">{gite.tag}</div>
          <h3>{activeRoom.titleLine1}<br>{activeRoom.titleLine2}</h3>
          <p class="gite-desc">{activeRoom.description}</p>
          <div class="gite-thumbs">
            {gite.rooms.map((room, i) => (
              <button
                class={`gite-thumb${i === 0 ? ' active' : ''}`}
                data-room={room.key}
                data-title-line1={room.titleLine1}
                data-title-line2={room.titleLine2}
                data-desc={room.description}
                data-btn={room.button}
                data-img={giteRoomImages[i].src}
              >{room.label}</button>
            ))}
          </div>
          <div class="m-btn">{activeRoom.button}</div>
        </div>
        <div class="demo-info">
          <div class="tag">{gite.info.tag}</div>
          <h3>{gite.info.title}</h3>
          <p class="place">{gite.info.place}</p>
          <p class="demo-more">{gite.info.more}</p>
          <ul>
            {gite.info.bullets.map((bullet) => (
              <li><span class="ck">→</span> {bullet}</li>
            ))}
          </ul>
          <div class="demo-stats">
            {gite.info.stats.map((stat) => (
              <div class="ds"><strong>{stat.value}</strong><span>{stat.label}</span></div>
            ))}
          </div>
        </div>
      </div>

      <!-- INSTITUT -->
      <div class="demo-card rv" style="margin-bottom:24px">
        <div class="demo-info">
          <div class="tag">{institut.info.tag}</div>
          <h3>{institut.info.title}</h3>
          <p class="place">{institut.info.place}</p>
          <p class="demo-more">{institut.info.more}</p>
          <ul>
            {institut.info.bullets.map((bullet) => (
              <li><span class="ck">→</span> {bullet}</li>
            ))}
          </ul>
          <div class="demo-stats">
            {institut.info.stats.map((stat) => (
              <div class="ds"><strong>{stat.value}</strong><span>{stat.label}</span></div>
            ))}
          </div>
        </div>
        <div class="demo-visual dv-moderne" style={`--photo:url('${activeSoinImage.src}')`}>
          <span class="badge">Concept</span>
          <span class="try-hint">À tester →</span>
          <div class="m-eye">{institut.tag}</div>
          <h3>{institut.titleLine1}<br>{institut.titleLine2}</h3>
          <div class="soin-picker">
            {institut.soins.map((soin, i) => (
              <button
                class={`soin-opt${i === 0 ? ' active' : ''}`}
                data-price={soin.price}
                data-duree={soin.duree}
                data-img={institutSoinImages[i].src}
              >{soin.label}</button>
            ))}
          </div>
          <div class="soin-detail"><span class="soin-price">{activeSoin.price}</span><span class="soin-duree">{activeSoin.duree}</span></div>
          <div class="m-btn">{institut.button}</div>
        </div>
      </div>

      <!-- ARTISAN -->
      <div class="demo-card rv" style="margin-bottom:24px">
        <div class="demo-visual dv-industriel" style={`--photo:url('${artisanImage.src}')`}>
          <span class="badge">Concept</span>
          <span class="try-hint">À tester →</span>
          <div class="m-eye">Artisan métallier · Style Industriel</div>
          <h3>{artisan.titleLine1}<br>{artisan.titleLine2}</h3>
          <div class="devis-calc">
            {artisan.checkboxes.map((box) => (
              <label class="devis-opt"><input type="checkbox" data-min={box.min} data-max={box.max} checked={box.checked} /> {box.label}</label>
            ))}
          </div>
          <div class="devis-total"><span>Estimation</span><strong>{artisanEstimateMin} € – {artisanEstimateMax} €</strong></div>
        </div>
        <div class="demo-info">
          <div class="tag">{artisan.info.tag}</div>
          <h3>{artisan.info.title}</h3>
          <p class="place">{artisan.info.place}</p>
          <p class="demo-more">{artisan.info.more}</p>
          <ul>
            {artisan.info.bullets.map((bullet) => (
              <li><span class="ck">→</span> {bullet}</li>
            ))}
          </ul>
          <div class="demo-stats">
            {artisan.info.stats.map((stat) => (
              <div class="ds"><strong>{stat.value}</strong><span>{stat.label}</span></div>
            ))}
          </div>
        </div>
      </div>

      <!-- RÉSEAUX SOCIAUX -->
      <div class="demo-card rv">
        <div class="demo-visual" style="align-items:center;background:linear-gradient(160deg,#1c2429,#13181b)">
          <span class="badge">Exemple de style</span>
          <span class="try-hint">À tester →</span>
          <div class="phone-frame" style="margin-top:30px">
            <div class="ph-bar"><i></i></div>
            <div class="ig-grid ig-grid-live">
              {socialFeed.cells.map((cell, i) => (
                <button class="ig-cell" data-type={cell.type} data-sujet={cell.sujet} style={`background-image:url('${socialCellImages[i].src}')`}></button>
              ))}
            </div>
            <div class="ig-reveal"><span class="ig-reveal-type">Post</span><span class="ig-reveal-sujet">Cliquez sur une case du feed</span></div>
          </div>
        </div>
        <div class="demo-info">
          <div class="tag">{socialFeed.info.tag}</div>
          <h3>{socialFeed.info.title}</h3>
          <p class="place">{socialFeed.info.place}</p>
          <p class="demo-more">{socialFeed.info.more}</p>
          <ul>
            {socialFeed.info.bullets.map((bullet) => (
              <li><span class="ck">→</span> {bullet}</li>
            ))}
          </ul>
          <div class="demo-stats">
            {socialFeed.info.stats.map((stat) => (
              <div class="ds"><strong>{stat.value}</strong><span>{stat.label}</span></div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="contact">
    <div class="wrap cta-band rv">
      <div class="sec-eye">{finalCta.eyebrow}</div>
      <h2 class="sec-h">{finalCta.title}</h2>
      <a href={finalCta.ctaHref} class="btn btn-primary">{finalCta.ctaLabel}</a>
    </div>
  </section>
</Layout>
