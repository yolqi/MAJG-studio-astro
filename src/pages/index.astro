---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const home = await getEntry('home', 'home');
const { seo, hero, painPoint, services, process: howItWorks, pricingTeaser, finalCta } = home.data;
---
<Layout title={seo.title} description={seo.description} activePage="accueil">
  <!-- HERO -->
  <header class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">{hero.eyebrow}</span>
        <h1>{hero.title} <em>{hero.titleEmphasis}</em>.</h1>
        <p class="lead">{hero.lead}</p>
        <div class="hero-actions">
          <a href={hero.ctaPrimaryHref} class="btn btn-primary">{hero.ctaPrimaryLabel}</a>
          <a href={hero.ctaGhostHref} class="btn btn-ghost">{hero.ctaGhostLabel}</a>
        </div>
        <div class="hero-stats">
          {hero.stats.map((stat) => (
            <div class="stat"><strong>{stat.value}</strong><span>{stat.label}</span></div>
          ))}
        </div>
      </div>
      <div class="rv">
        <div class="mock">
          <div class="mock-bar">
            <i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i>
            <span class="mock-url">votre-commerce.fr</span>
          </div>
          <div class="mock-body">
            <div class="m-eye">Votre salon · Votre quartier</div>
            <div class="m-h">L'art de la coupe,<br>au cœur du 4e.</div>
            <div class="m-btn">Prendre rendez-vous</div>
            <div class="mock-tag">exemple de rendu</div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- MARQUEE -->
  <div class="marquee">
    <div class="marquee-track">
      <span>◆ Coiffeurs &amp; barbiers</span><span>◆ Restaurants &amp; cafés</span><span>◆ Gîtes &amp; hôtels</span><span>◆ Artisans</span><span>◆ <b>Optimisé pour Google</b></span><span>◆ Instituts de beauté</span><span>◆ Réseaux sociaux</span><span>◆ <b>Démo gratuite</b></span><span>◆ Sites sur-mesure</span><span>◆ Commerces de quartier</span><span>◆ Contenu Instagram</span><span>◆ Parfait sur mobile</span><span>◆ Hébergement inclus</span><span>◆ Shooting photo &amp; vidéo</span>
      <span>◆ Coiffeurs &amp; barbiers</span><span>◆ Restaurants &amp; cafés</span><span>◆ Gîtes &amp; hôtels</span><span>◆ Artisans</span><span>◆ <b>Optimisé pour Google</b></span><span>◆ Instituts de beauté</span><span>◆ Réseaux sociaux</span><span>◆ <b>Démo gratuite</b></span><span>◆ Sites sur-mesure</span><span>◆ Commerces de quartier</span><span>◆ Contenu Instagram</span><span>◆ Parfait sur mobile</span><span>◆ Hébergement inclus</span><span>◆ Shooting photo &amp; vidéo</span>
    </div>
  </div>

  <!-- POINT DE DOULEUR -->
  <section>
    <div class="wrap">
      <div class="pain-grid">
        <div class="rv prose">
          <div class="sec-eye">{painPoint.eyebrow}</div>
          <h2 class="sec-h">{painPoint.title}</h2>
          <p>{painPoint.paragraph1}</p>
          <p>{painPoint.paragraph2} <a href={painPoint.discoverLinkHref} class="inline-link">{painPoint.discoverLinkLabel}</a></p>
        </div>
        <div class="pull-stat rv">
          <strong>{painPoint.statValue}</strong>
          <span>{painPoint.statLabel}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES — TEASER 2 CARTES -->
  <section style="padding-top:0">
    <div class="wrap">
      <div class="rv">
        <div class="sec-eye">{services.eyebrow}</div>
        <h2 class="sec-h">{services.title}</h2>
        <p class="sec-sub">{services.subtitle}</p>
      </div>
      <div class="svc-grid">
        {services.items.map((item) => (
          <a href={item.href} class="svc-card svc-link rv">
            <div class="svc-num">{item.number}</div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span class="go">Découvrir →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="proc">
    <div class="wrap">
      <div class="rv">
        <div class="sec-eye">{howItWorks.eyebrow}</div>
        <h2 class="sec-h">{howItWorks.title}</h2>
        <p class="sec-sub">{howItWorks.subtitle}</p>
      </div>
      <div class="proc-grid">
        {howItWorks.steps.map((step) => (
          <div class="proc-step rv"><div class="n">{step.number}</div><h4>{step.title}</h4><p>{step.description}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- TEASER TARIFS -->
  <section>
    <div class="wrap cta-band rv">
      <div class="sec-eye">{pricingTeaser.eyebrow}</div>
      <h2 class="sec-h">{pricingTeaser.title}</h2>
      <p class="sec-sub">{pricingTeaser.subtitle}</p>
      <a href={pricingTeaser.ctaHref} class="btn btn-primary">{pricingTeaser.ctaLabel}</a>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="contact">
    <div class="wrap cta-band rv">
      <div class="sec-eye">{finalCta.eyebrow}</div>
      <h2 class="sec-h">{finalCta.title}</h2>
      <p class="sec-sub" style="color:var(--sand);opacity:.75">{finalCta.subtitle}</p>
      <a href={finalCta.ctaHref} class="btn btn-primary">{finalCta.ctaLabel}</a>
    </div>
  </section>
</Layout>
