---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('nousSommes', 'nous-sommes');
const { seo, hero, constat, founders, finalCta } = page.data;
---
<Layout title={seo.title} description={seo.description} activePage="nous-sommes">
  <!-- HERO -->
  <header class="hero">
    <div class="wrap hero-solo">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1>{hero.title} <em>{hero.titleEmphasis}</em></h1>
      <p class="lead">{hero.lead}</p>
    </div>
  </header>

  <!-- LE CONSTAT, VERSION COMPLÈTE -->
  <section>
    <div class="wrap">
      <div class="rv prose">
        <div class="sec-eye">{constat.eyebrow}</div>
        <h2 class="sec-h">{constat.title}</h2>
        {constat.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- FONDATEURS -->
  <section style="background:var(--bg2)">
    <div class="wrap">
      <div class="rv">
        <div class="sec-eye">{founders.eyebrow}</div>
        <h2 class="sec-h">{founders.title}</h2>
        <p class="sec-sub">{founders.subtitle}</p>
      </div>
      <div class="founders-grid">
        {founders.people.map((person) => (
          <div class="founder-card rv">
            <h3>{person.name}</h3>
            <p>{person.bio}</p>
          </div>
        ))}
      </div>
      <p class="founders-reveal rv">{founders.revealText}</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="contact">
    <div class="wrap cta-band rv">
      <div class="sec-eye">{finalCta.eyebrow}</div>
      <h2 class="sec-h">{finalCta.title}</h2>
      <a href={finalCta.ctaHref} class="btn btn-primary">{finalCta.ctaLabel}</a>
    </div>
  </section>
</Layout>
