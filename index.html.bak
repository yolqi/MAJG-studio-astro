<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ad Vitrine — Création de sites web pour commerçants à Marseille</title>
<meta name="description" content="Ad Vitrine crée des sites web sur-mesure pour les commerçants et artisans de Marseille. Design soigné, visible sur Google, hébergement et accompagnement. Démo gratuite avant tout engagement.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#13181b;
    --ink2:#1c2429;
    --night:#0d1114;
    --terra:#c8693f;
    --terra-bright:#e08a5c;
    --sand:#ead9c9;
    --paper:#f7f3ee;
    --paper2:#efe7dc;
    --white:#ffffff;
    --muted:#6f6358;
    --line:rgba(19,24,27,0.10);
    --line-d:rgba(234,217,201,0.16);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{font-family:'Inter',sans-serif;background:var(--paper);color:var(--ink);line-height:1.6;overflow-x:hidden;max-width:100vw}
  img{max-width:100%;height:auto}
  h1,h2,h3,h4{font-family:'Archivo',sans-serif;line-height:1.02;letter-spacing:-0.02em}
  .wrap{max-width:1200px;margin:0 auto;padding:0 32px}
  a{text-decoration:none;color:inherit}
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}html{scroll-behavior:auto}}

  /* NAV */
  nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;
    padding:18px 32px;background:rgba(13,17,20,0);transition:background .35s,padding .35s,border-color .35s;border-bottom:1px solid transparent}
  nav.scrolled{background:rgba(13,17,20,.94);backdrop-filter:blur(12px);padding:12px 32px;border-bottom:1px solid var(--line-d)}
  .nav-logo{height:46px;display:flex;align-items:center}
  .nav-logo img{height:100%;width:auto}
  .nav-links{display:flex;gap:30px;align-items:center}
  .nav-links a{color:var(--sand);font-size:.92rem;font-weight:500;opacity:.82;transition:opacity .2s,color .2s}
  .nav-links a:hover{opacity:1;color:var(--terra-bright)}
  .nav-cta{background:var(--terra);color:var(--white)!important;padding:10px 20px;border-radius:8px;opacity:1!important;font-weight:600;transition:background .2s,transform .2s}
  .nav-cta:hover{background:var(--terra-bright);transform:translateY(-1px)}
  .burger{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:0;padding:4px}
  .burger span{width:26px;height:2px;background:var(--sand);transition:.3s}

  /* HERO */
  .hero{position:relative;background:var(--night);color:var(--sand);padding:150px 0 90px;overflow:hidden}
  .hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(var(--line-d) 1px,transparent 1px),linear-gradient(90deg,var(--line-d) 1px,transparent 1px);background-size:64px 64px;opacity:.5;mask-image:radial-gradient(ellipse 80% 70% at 30% 20%,#000 30%,transparent 75%)}
  .hero-grid{position:relative;display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
  .eyebrow{display:inline-flex;align-items:center;gap:10px;font-family:'Archivo',sans-serif;font-size:.74rem;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--terra-bright);margin-bottom:24px}
  .eyebrow::before{content:"";width:30px;height:1px;background:var(--terra)}
  .hero h1{font-size:clamp(2.6rem,5.4vw,4.3rem);font-weight:800;color:var(--white);margin-bottom:22px}
  .hero h1 em{font-style:normal;color:var(--terra-bright)}
  .hero p.lead{font-size:1.15rem;color:var(--sand);max-width:520px;margin-bottom:34px;opacity:.9}
  .hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:46px}
  .btn{display:inline-flex;align-items:center;gap:9px;padding:15px 28px;border-radius:9px;font-family:'Archivo',sans-serif;font-weight:600;font-size:.96rem;cursor:pointer;border:0;transition:all .22s}
  .btn-primary{background:var(--terra);color:var(--white)}
  .btn-primary:hover{background:var(--terra-bright);transform:translateY(-2px)}
  .btn-ghost{background:transparent;color:var(--sand);border:1px solid var(--line-d)}
  .btn-ghost:hover{border-color:var(--terra-bright);color:var(--terra-bright)}
  .hero-stats{display:flex;gap:36px;flex-wrap:wrap}
  .hero-stats .stat strong{display:block;font-family:'Archivo',sans-serif;font-size:1.9rem;font-weight:800;color:var(--white);line-height:1}
  .hero-stats .stat span{font-size:.82rem;color:var(--sand);opacity:.7}

  /* BROWSER MOCKUP */
  .mock{background:var(--ink2);border-radius:14px;overflow:hidden;box-shadow:0 30px 70px rgba(0,0,0,.45);border:1px solid var(--line-d)}
  .mock-bar{display:flex;align-items:center;gap:7px;padding:12px 14px;background:var(--ink);border-bottom:1px solid var(--line-d)}
  .mock-bar i{width:11px;height:11px;border-radius:50%;display:block}
  .mock-url{margin-left:12px;font-size:.74rem;color:var(--sand);opacity:.6;font-family:'Archivo',sans-serif}
  .mock-body{position:relative;aspect-ratio:16/11;background:linear-gradient(160deg,#14110f 0%,#1d1814 100%);padding:26px 24px;display:flex;flex-direction:column;justify-content:center}
  .mock-body .m-eye{font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:#e0bf6e;margin-bottom:10px}
  .mock-body .m-h{font-family:'Archivo',sans-serif;font-weight:800;font-size:1.7rem;color:#f6f1e9;line-height:1.05;margin-bottom:14px}
  .mock-body .m-btn{align-self:flex-start;background:#c9a24b;color:#14110f;font-size:.7rem;font-weight:700;padding:8px 16px;border-radius:20px;font-family:'Archivo',sans-serif}
  .mock-tag{position:absolute;bottom:14px;right:16px;font-size:.58rem;color:#7d6a4a;font-style:italic}

  /* SECTIONS */
  section{padding:96px 0}
  .sec-eye{font-family:'Archivo',sans-serif;font-size:.74rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--terra);margin-bottom:14px}
  .sec-h{font-size:clamp(1.9rem,3.6vw,2.9rem);font-weight:800;max-width:680px;margin-bottom:18px}
  .sec-h em{font-style:normal;color:var(--terra)}
  .sec-sub{font-size:1.06rem;color:var(--muted);max-width:600px;margin-bottom:54px}

  /* MARQUEE */
  .marquee{background:var(--ink);color:var(--sand);padding:18px 0;overflow:hidden;white-space:nowrap}
  .marquee-track{display:inline-block;animation:scroll 32s linear infinite}
  .marquee span{font-family:'Archivo',sans-serif;font-weight:600;font-size:.92rem;margin:0 26px;opacity:.85}
  .marquee b{color:var(--terra-bright)}
  @keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  /* SERVICES */
  .svc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
  .svc-card{background:var(--white);border:1px solid var(--line);border-radius:14px;padding:32px;transition:transform .25s,box-shadow .25s}
  .svc-card:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(19,24,27,.08)}
  .svc-num{font-family:'Archivo',sans-serif;font-weight:800;font-size:.9rem;color:var(--terra);margin-bottom:16px}
  .svc-card h3{font-size:1.3rem;font-weight:700;margin-bottom:10px}
  .svc-card p{color:var(--muted);font-size:.97rem}

  /* FEATURES */
  .features{background:var(--ink);color:var(--sand)}
  .features .sec-eye{color:var(--terra-bright)}
  .features .sec-h{color:var(--white)}
  .features .sec-sub{color:var(--sand);opacity:.75}
  .feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line-d);border:1px solid var(--line-d);border-radius:14px;overflow:hidden}
  .feat{background:var(--ink);padding:30px}
  .feat .ic{width:42px;height:42px;border-radius:10px;background:rgba(200,105,63,.16);display:flex;align-items:center;justify-content:center;margin-bottom:16px;font-size:1.2rem}
  .feat h4{color:var(--white);font-size:1.08rem;font-weight:600;margin-bottom:8px}
  .feat p{font-size:.92rem;opacity:.72}

  /* DEMO / BEVERLY */
  .demo-card{display:grid;grid-template-columns:1fr 1fr;gap:0;background:var(--white);border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 20px 50px rgba(19,24,27,.07)}
  .demo-visual{background:linear-gradient(160deg,#14110f,#221b16);padding:40px;display:flex;flex-direction:column;justify-content:center;color:#f6f1e9;position:relative}
  .demo-visual .badge{position:absolute;top:18px;left:18px;background:var(--terra);color:#fff;font-size:.62rem;font-weight:700;font-family:'Archivo',sans-serif;letter-spacing:.08em;padding:5px 11px;border-radius:20px;text-transform:uppercase}
  .demo-visual .m-eye{font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:#e0bf6e;margin:14px 0 10px}
  .demo-visual h3{font-size:2rem;font-weight:800;line-height:1.04;margin-bottom:14px;color:#fff}
  .demo-visual .m-btn{align-self:flex-start;background:#c9a24b;color:#14110f;font-size:.74rem;font-weight:700;padding:9px 18px;border-radius:22px;font-family:'Archivo',sans-serif;margin-top:6px}
  .demo-info{padding:40px}
  .demo-info .tag{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--terra);font-weight:600;font-family:'Archivo',sans-serif;margin-bottom:12px}
  .demo-info h3{font-size:1.6rem;font-weight:800;margin-bottom:8px}
  .demo-info .place{color:var(--muted);font-size:.95rem;margin-bottom:20px}
  .demo-info ul{list-style:none;display:flex;flex-direction:column;gap:11px;margin-bottom:24px}
  .demo-info li{display:flex;gap:11px;align-items:flex-start;font-size:.96rem}
  .demo-info li .ck{color:var(--terra);font-weight:800;flex-shrink:0}
  .demo-stats{display:flex;gap:30px;padding-top:20px;border-top:1px solid var(--line)}
  .demo-stats .ds strong{display:block;font-family:'Archivo',sans-serif;font-size:1.6rem;font-weight:800;color:var(--terra)}
  .demo-stats .ds span{font-size:.78rem;color:var(--muted)}

  /* EXAMPLES */
  .ex-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .ex{background:var(--white);border:1px solid var(--line);border-radius:14px;overflow:hidden;transition:transform .25s,box-shadow .25s}
  .ex:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(19,24,27,.08)}
  .ex-prev{aspect-ratio:4/3;padding:22px;display:flex;flex-direction:column;justify-content:center;position:relative}
  .ex-prev .u{position:absolute;top:12px;left:14px;font-size:.58rem;opacity:.5;font-family:'Archivo',sans-serif}
  .ex-prev h4{font-size:1.25rem;font-weight:800;line-height:1.06}
  .ex-1{background:linear-gradient(155deg,#2d3a2f,#46553f);color:#f3 efe6}
  .ex-1{color:#f3efe6}
  .ex-2{background:linear-gradient(155deg,#3a2730,#5c4150);color:#f4e9ec}
  .ex-3{background:linear-gradient(155deg,#16181d,#2a2e36);color:#e9eef4}
  .ex-body{padding:22px}
  .ex-body .k{font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--terra);font-weight:600;font-family:'Archivo',sans-serif;margin-bottom:8px}
  .ex-body h4{font-size:1.05rem;font-weight:700;margin-bottom:6px}
  .ex-body p{font-size:.9rem;color:var(--muted)}

  /* PROCESS */
  .proc{background:var(--paper2)}
  .proc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .proc-step{position:relative}
  .proc-step .n{font-family:'Archivo',sans-serif;font-size:2.6rem;font-weight:900;color:var(--terra);opacity:.28;line-height:1;margin-bottom:10px}
  .proc-step h4{font-size:1.2rem;font-weight:700;margin-bottom:8px}
  .proc-step p{color:var(--muted);font-size:.96rem}

  /* PRICING */
  .price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:stretch}
  .price{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:34px;display:flex;flex-direction:column}
  .price.feat-price{background:var(--ink);color:var(--sand);border-color:var(--ink);transform:scale(1.02)}
  .price .pname{font-family:'Archivo',sans-serif;font-weight:700;font-size:1.15rem;margin-bottom:6px}
  .price .ptag{font-size:.88rem;color:var(--muted);margin-bottom:20px}
  .price.feat-price .ptag{color:var(--sand);opacity:.7}
  .price .pprice{font-family:'Archivo',sans-serif;font-size:2.2rem;font-weight:800;margin-bottom:4px}
  .price .pprice small{font-size:.9rem;font-weight:500;color:var(--muted)}
  .price.feat-price .pprice small{color:var(--sand)}
  .price .pfrom{font-size:.78rem;color:var(--muted);margin-bottom:22px}
  .price.feat-price .pfrom{color:var(--sand);opacity:.7}
  .price ul{list-style:none;display:flex;flex-direction:column;gap:11px;margin-bottom:26px;flex-grow:1}
  .price li{font-size:.93rem;display:flex;gap:10px;align-items:flex-start}
  .price li .ck{color:var(--terra);font-weight:800;flex-shrink:0}
  .price.feat-price li .ck{color:var(--terra-bright)}
  .price .badge-pop{position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:var(--terra);color:#fff;font-size:.64rem;font-weight:700;font-family:'Archivo',sans-serif;letter-spacing:.08em;text-transform:uppercase;padding:5px 14px;border-radius:20px}
  .price-wrap{position:relative}
  .btn-full{width:100%;justify-content:center}
  .btn-dark{background:var(--ink);color:var(--white)}
  .btn-dark:hover{background:var(--ink2)}

  /* FAQ */
  .faq-list{max-width:820px;margin:0 auto}
  .faq-item{border-bottom:1px solid var(--line)}
  .faq-q{width:100%;text-align:left;background:none;border:0;padding:24px 0;font-family:'Archivo',sans-serif;font-weight:600;font-size:1.12rem;color:var(--ink);cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px}
  .faq-q .pm{color:var(--terra);font-size:1.5rem;flex-shrink:0;transition:transform .25s}
  .faq-item.open .pm{transform:rotate(45deg)}
  .faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;color:var(--muted);font-size:.99rem}
  .faq-a p{padding-bottom:24px}

  /* CONTACT */
  .contact{background:var(--ink);color:var(--sand)}
  .contact .sec-eye{color:var(--terra-bright)}
  .contact .sec-h{color:var(--white)}
  .contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:50px}
  .contact-info .ci{margin-bottom:26px}
  .contact-info .ci .l{font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:var(--terra-bright);font-weight:600;font-family:'Archivo',sans-serif;margin-bottom:6px}
  .contact-info .ci .v{font-size:1.15rem;color:var(--white)}
  .form-card{background:var(--ink2);border:1px solid var(--line-d);border-radius:16px;padding:32px}
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
  .field{margin-bottom:14px}
  .field label{display:block;font-size:.82rem;color:var(--sand);opacity:.8;margin-bottom:6px;font-weight:500}
  .field input,.field select,.field textarea{width:100%;background:var(--night);border:1px solid var(--line-d);border-radius:8px;padding:12px 14px;color:var(--white);font-family:'Inter',sans-serif;font-size:.95rem}
  .field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--terra)}
  .field textarea{resize:vertical;min-height:90px}
  .form-note{font-size:.8rem;color:var(--sand);opacity:.6;margin-top:10px}

  /* FOOTER */
  footer{background:var(--night);color:var(--sand);padding:56px 0 30px}
  .foot-top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:30px;padding-bottom:36px;border-bottom:1px solid var(--line-d)}
  .foot-logo{height:54px}
  .foot-logo img{height:100%}
  .foot-col h5{font-family:'Archivo',sans-serif;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--white);margin-bottom:14px}
  .foot-col a,.foot-col p{display:block;color:var(--sand);opacity:.72;font-size:.92rem;margin-bottom:7px;transition:opacity .2s,color .2s}
  .foot-col a:hover{opacity:1;color:var(--terra-bright)}
  .foot-cols{display:flex;gap:60px;flex-wrap:wrap}
  .foot-bottom{padding-top:22px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:.82rem;opacity:.6}

  /* reveal */
  .rv{opacity:0;transform:translateY(26px);transition:opacity .7s,transform .7s}
  .rv.in{opacity:1;transform:none}

  @media(max-width:900px){
    .hero-grid,.demo-card,.contact-grid{grid-template-columns:1fr}
    .svc-grid,.feat-grid,.ex-grid,.proc-grid,.price-grid{grid-template-columns:1fr}
    .demo-visual{min-height:240px}
    .demo-visual h3{font-size:1.6rem}
    .demo-visual,.demo-info{padding:30px}
    .demo-info h3{font-size:1.4rem}
    .demo-stats{flex-wrap:wrap;gap:20px}
    .demo-stats .ds{min-width:42%}
    .nav-links{position:fixed;inset:0 0 0 auto;width:78%;max-width:320px;background:var(--ink);flex-direction:column;justify-content:center;gap:26px;transform:translateX(100%);transition:transform .35s;padding:40px;z-index:99}
    .nav-links.open{transform:none}
    .burger{display:flex;z-index:101}
    .price.feat-price{transform:none}
    .hero{padding:120px 0 70px}
    section{padding:70px 0}
  }
  @media(max-width:480px){
    .wrap{padding:0 20px}
    .demo-visual h3{font-size:1.4rem}
    .demo-visual,.demo-info{padding:24px}
    .demo-stats .ds strong{font-size:1.3rem}
    .demo-stats .ds{min-width:100%}
  }
</style>
</head>
<body>
<nav id="nav">
  <a href="#accueil" class="nav-logo"><img src="data:image/png;base64," alt="Ad Vitrine"></a>
  <div class="nav-links" id="navLinks">
    <a href="#services">Ce qu'on fait</a>
    <a href="#realisations">Réalisations</a>
    <a href="#offres">Offres</a>
    <a href="#process">Méthode</a>
    <a href="#contact" class="nav-cta">Démo gratuite</a>
  </div>
  <button class="burger" id="burger" aria-label="Menu"><span></span><span></span><span></span></button>
</nav>

<!-- HERO -->
<header class="hero" id="accueil">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow">Création de sites web · Marseille</span>
      <h1>Votre commerce mérite une <em>vraie vitrine</em> en ligne.</h1>
      <p class="lead">On conçoit des sites sur-mesure pour les commerçants et artisans de Marseille. Et on commence par vous montrer le vôtre — avant même que vous décidiez quoi que ce soit.</p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">Voir une démo de mon site →</a>
        <a href="#realisations" class="btn btn-ghost">Nos réalisations</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><strong>Sur-mesure</strong><span>Jamais de template recopié</span></div>
        <div class="stat"><strong>Démo d'abord</strong><span>Vous voyez avant de payer</span></div>
        <div class="stat"><strong>Tout inclus</strong><span>Hébergement & mise en ligne</span></div>
      </div>
    </div>
    <div class="rv">
      <div class="mock">
        <div class="mock-bar">
          <i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i>
          <span class="mock-url">votre-commerce.fr</span>
        </div>
        <div class="mock-body">
          <div class="m-eye">Votre salon · Votre quartier</div>
          <div class="m-h">L'art de la coupe,<br>au cœur du 4e.</div>
          <div class="m-btn">Prendre rendez-vous</div>
          <div class="mock-tag">exemple de rendu</div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- MARQUEE -->
<div class="marquee">
  <div class="marquee-track">
    <span>◆ Coiffeurs &amp; barbiers</span><span>◆ Restaurants &amp; cafés</span><span>◆ Artisans</span><span>◆ <b>Visible sur Google</b></span><span>◆ Commerces de quartier</span><span>◆ Parfait sur mobile</span><span>◆ <b>Démo gratuite</b></span><span>◆ Hébergement inclus</span>
    <span>◆ Coiffeurs &amp; barbiers</span><span>◆ Restaurants &amp; cafés</span><span>◆ Artisans</span><span>◆ <b>Visible sur Google</b></span><span>◆ Commerces de quartier</span><span>◆ Parfait sur mobile</span><span>◆ <b>Démo gratuite</b></span><span>◆ Hébergement inclus</span>
  </div>
</div>

<!-- SERVICES -->
<section id="services">
  <div class="wrap">
    <div class="rv">
      <div class="sec-eye">Ce qu'on fait</div>
      <h2 class="sec-h">Un site pensé pour <em>votre activité</em>, pas pour une autre.</h2>
      <p class="sec-sub">Pas de modèle générique vu partout. Chaque site est conçu autour de votre métier, de vos clients et de votre quartier.</p>
    </div>
    <div class="svc-grid">
